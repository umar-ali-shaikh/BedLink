# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/bedlink
# true needs a replica set (Atlas is one). Use false for a standalone local mongod.
MONGO_TRANSACTIONS=true
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# Handshake & reservation
OFFER_TIMEOUT_SECONDS=120
RESERVATION_HOLD_MINUTES=30
SWEEPER_INTERVAL_SECONDS=10
# Login attempts per minute per IP. Raise locally to run the full Postman collection.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Matching
FRESHNESS_FRESH_SECONDS=120
FRESHNESS_RECENT_SECONDS=600
MATCH_MAX_ETA_MINUTES=60
MATCH_CRITICAL_LOAD=95
MATCH_MAX_RADIUS_KM=50
CONFIDENCE_TIMEOUT_WINDOW_MINUTES=30
AVG_AMBULANCE_SPEED_KMPH=30
ROAD_FACTOR=1.3

# ─── Client (Vite exposes only VITE_*) ─────────────────
# Dev: leave unset — Vite proxies /api and /socket.io to VITE_PROXY_TARGET.
# Production build: set both to the deployed server.
# VITE_API_URL=https://<your-api-host>/api
# VITE_SOCKET_URL=https://<your-api-host>
# VITE_PROXY_TARGET=http://localhost:5000
# VITE_SHOW_DEMO_ACCOUNTS=true
