# ─── BedLink server ───────────────────────────────────────────────────────
# Copy to server/.env (dev) or set in your host's dashboard (Render/Railway/VPS).
# Real environment variables win over server/.env, which wins over a repo-root .env.
# The server validates everything at boot and refuses to start with a clear message.

NODE_ENV=development                 # production on the host
PORT=5000                            # most hosts inject PORT automatically
HOST=0.0.0.0
# LOG_LEVEL=info                     # debug | info | warn | error

# ── Required ──
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/bedlink
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars

# true needs a replica set (Atlas is one). false for a standalone local mongod.
MONGO_TRANSACTIONS=true
JWT_EXPIRES_IN=8h

# Browser origin(s) of the client, comma-separated: scheme + host (+ port) only.
# e.g. https://bed-link-pi.vercel.app   (a path like /login is stripped automatically)
CLIENT_ORIGIN=http://localhost:5173

# ── Deployment knobs (leave unset for the NODE_ENV default) ──
# Proxy hops in front of the app (Render/Railway/Nginx = 1). Default: 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Auth cookie. Default: SameSite=none + Secure when NODE_ENV=production OR CLIENT_ORIGIN is a
# deployed https site (client and API on different sites, e.g. Vercel + Render); lax for localhost.
# Same-site deploy (e.g. app.example.com + api.example.com, or one domain): lax is fine.
# COOKIE_SAMESITE=none               # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# Only if your network can't resolve Atlas SRV records (querySrv ECONNREFUSED):
# DNS_SERVERS=8.8.8.8,8.8.4.4
# On startup, remove sample data from older versions (@bedlink.demo users except the admin,
# the sample hospitals and their data). Real registrations are never touched. Default: true.
PURGE_DEMO_DATA=true

# ── Admin verification panel ──
# Creates this admin at startup (or resets its password to this value). Use a strong password.
# Tip: ADMIN_EMAIL=admin@bedlink.demo replaces the public demo admin password.
# ADMIN_EMAIL=you@yourdomain.in
# ADMIN_PASSWORD=change-me-to-a-long-password
# ADMIN_NAME=BedLink Admin
# Or skip env and run: npm run admin -- create you@yourdomain.in "Name"

# ── Address search (place name / address → coordinates) ──
# Nominatim-compatible geocoder; default is OpenStreetMap's free public service.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Contact email Nominatim asks for (put yours).
# GEOCODER_EMAIL=you@example.com
# Limit results to countries (ISO codes, comma-separated). Empty = worldwide.
GEOCODER_COUNTRY=in

# ── Registration ──
# Public sign-up for ambulances and hospitals.
REGISTRATION_ENABLED=true
# Hospitals start PENDING until verified with `npm run hospitals -- verify <id>`.
# true = skip verification (demos only — anyone could register a fake hospital).
HOSPITAL_AUTO_VERIFY=false
# Ambulances also start PENDING (can sign in, can't request beds) until an admin approves them.
AMBULANCE_AUTO_VERIFY=false
REGISTER_RATE_LIMIT_PER_HOUR=10

# ── Handshake & reservation ──
OFFER_TIMEOUT_SECONDS=120
RESERVATION_HOLD_MINUTES=30
SWEEPER_INTERVAL_SECONDS=10
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── Matching (keep FRESHNESS_* and MATCH_CRITICAL_LOAD equal to the client's VITE_* copies) ──
FRESHNESS_FRESH_SECONDS=120
FRESHNESS_RECENT_SECONDS=600
MATCH_MAX_ETA_MINUTES=60
MATCH_CRITICAL_LOAD=95
MATCH_MAX_RADIUS_KM=50
CONFIDENCE_TIMEOUT_WINDOW_MINUTES=30
AVG_AMBULANCE_SPEED_KMPH=30
ROAD_FACTOR=1.3

# ── Public ambulance booking (/book, /track/:token — no login) ──
# Seconds an ambulance has to accept or reject an offered booking, then the next nearest is tried.
BOOKING_OFFER_TIMEOUT_SECONDS=60
# On-duty ambulances only receive bookings if their last GPS position is newer than this.
AMBULANCE_LOCATION_MAX_AGE_SECONDS=120
# Server-side floor between two stored positions of one ambulance (the client sends 1 per 10 s).
AMBULANCE_LOCATION_MIN_INTERVAL_SECONDS=10
# Abuse protection without login: new bookings per IP / per phone number per hour.
BOOKING_RATE_LIMIT_PER_IP_PER_HOUR=10
BOOKING_RATE_LIMIT_PER_PHONE_PER_HOUR=5
# Closed bookings lose name, phone, notes and pickup (and their tracking link) after this many days.
BOOKING_PII_RETENTION_DAYS=30
# The ambulance counts as "reached the caller" (cancelling stops) within this distance of the pickup.
BOOKING_PICKUP_RADIUS_METERS=100

# ── Fake / prank booking reports ──
# An ambulance can cancel a booking as FAKE_OR_PRANK. This many reports on one phone number within the
# window block new bookings from it for FAKE_REPORT_BLOCK_HOURS after the latest report.
# Reports expire from the database after the window (TTL index; changing the window later needs the
# fake_report_ttl index dropped so it is recreated).
FAKE_REPORT_BLOCK_THRESHOLD=3
FAKE_REPORT_WINDOW_DAYS=30
FAKE_REPORT_BLOCK_HOURS=72
