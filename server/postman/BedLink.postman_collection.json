        {
          "name": "Create emergency ICU+Vent+Cardio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/emergencies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientLocation\": {\n    \"lat\": 19.076,\n    \"lng\": 72.8777\n  },\n  \"requirements\": {\n    \"bedType\": \"ICU\",\n    \"equipment\": [\n      \"VENTILATOR\"\n    ],\n    \"specialties\": [\n      \"CARDIOLOGY\"\n    ]\n  },\n  \"urgency\": \"CRITICAL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('emergencyId', d.id);",
                  "pm.test('demo patient id', () => pm.expect(d.demoPatientId).to.match(/^DEMO-P-/));",
                  "pm.test('Lakeside ranked first', () => pm.expect(d.candidates[0].hospitalName).to.eql('Lakeside Medical Centre'));",
                  "pm.test('candidates have reasons', () => pm.expect(d.candidates[0].reasons.length).to.be.above(3));",
                  "pm.test('exclusions explain why not', () => pm.expect(d.exclusions.map(e => e.reasons[0])).to.include.members(['MISSING_EQUIPMENT','CRITICAL_LOAD','NO_MATCHING_BED','MISSING_SPECIALTY','HOSPITAL_INACTIVE','OUT_OF_RANGE']));"
                ]
              }
            }
          ]
        },
