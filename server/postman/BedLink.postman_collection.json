          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('role ok', () => pm.expect(pm.response.json().data.user.email).to.eql('dispatcher1@bedlink.demo'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Emergency detail + timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/emergencies/{{emergencyId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('RESERVED', () => pm.expect(d.status).to.eql('RESERVED'));",
                  "pm.test('timeline order', () => pm.expect(d.timeline.map(t => t.event)).to.eql(['REQUEST_CREATED','MATCHING_COMPLETED','HOSPITAL_CONTACTED','HOSPITAL_REJECTED','HOSPITAL_CONTACTED','HOSPITAL_ACCEPTED','BED_RESERVED']));",
                  "pm.test('fallback by SYSTEM', () => pm.expect(d.timeline[4].actor.type).to.eql('SYSTEM'));"
                ]
              }
            }
          ]
        },
