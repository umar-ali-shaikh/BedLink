# ─── BedLink client (Vite) ────────────────────────────────────────────────
# Copy to client/.env (dev) or set in your host's dashboard (Vercel/Netlify/Render).
# Only VITE_* variables reach the browser, and they are baked in at BUILD time:
# change one → rebuild/redeploy. Never put secrets here.

# API + Socket.IO location.
# Dev: leave both unset — Vite proxies /api and /socket.io to VITE_PROXY_TARGET.
# Production with the API on another domain (e.g. Vercel + Render):
#   VITE_API_URL=https://your-api.onrender.com/api
#   VITE_SOCKET_URL=https://your-api.onrender.com
# Production behind one domain (reverse proxy sends /api + /socket.io to the server): leave unset.
VITE_API_URL=
VITE_SOCKET_URL=

# Dev server only
VITE_PROXY_TARGET=http://localhost:5000
VITE_DEV_PORT=5173

# Serve the app from a sub-path, e.g. /bedlink/ (default /)
VITE_BASE_PATH=/

# Optional label on dashboards ("Today · Pune"). Empty = "Today".
VITE_REGION_NAME=
# Where maps open before a location is chosen (default: all of India)
# VITE_MAP_CENTER_LAT=22.5
# VITE_MAP_CENTER_LNG=79
# VITE_MAP_ZOOM=5
VITE_APP_VERSION=0.1.0

# Must match the server's FRESHNESS_* and MATCH_CRITICAL_LOAD
VITE_FRESHNESS_FRESH_SECONDS=120
VITE_FRESHNESS_RECENT_SECONDS=600
VITE_MATCH_CRITICAL_LOAD=95

# Map tiles (default OpenStreetMap)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

VITE_SOURCEMAP=false
